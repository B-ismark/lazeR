# --- Secrets / machine-local (never commit) ---
# Match anywhere: the frozen exe writes these next to itself (e.g. dist/) too.
.lazer_key
.lazer_token
android/local.properties

# --- Python ---
__pycache__/
*.pyc
# The uv-managed venv CLAUDE.md tells you to create (server/.venv) — machine-local.
.venv/

# --- PyInstaller / native build output ---
/build/
*.spec

# --- Android / Gradle build output ---
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/build_icon.log
.gradle/

# --- Distribution: keep helper scripts + docs, drop built binaries & dupes ---
dist/LazeR.exe
dist/LazeR.apk
dist/server/
dist/PROTOCOL.md
dist/_*.txt

# --- Top-level build artifacts ---
*.apk
*.exe
*.zip

# --- Vendored 3rd-party binary ---
tools/upx/

# --- Editor ---
.vscode/
.idea/
