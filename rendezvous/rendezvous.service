[Unit]
Description=LazeR rendezvous coordinator (UDP hole-punch + relay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust the path if you cloned elsewhere. No venv needed — stdlib only.
ExecStart=/usr/bin/python3 /opt/lazer-rendezvous/rendezvous_server.py --port 50510
Restart=always
RestartSec=3
# Hardening: it needs nothing but the network.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
