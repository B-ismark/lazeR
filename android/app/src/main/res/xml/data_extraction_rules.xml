<?xml version="1.0" encoding="utf-8"?>
<!-- Saved laptop tokens live in SharedPreferences. Never include them in cloud
     backups or device-to-device transfers, so a leaked backup can't leak tokens. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="lazer_devices.xml" />
        <exclude domain="sharedpref" path="lazer_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lazer_devices.xml" />
        <exclude domain="sharedpref" path="lazer_keys.xml" />
    </device-transfer>
</data-extraction-rules>
